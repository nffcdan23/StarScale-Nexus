{
  "name": "starscale-nexus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:security && npm run test:tools && npm run build",
    "test:security": "node tests/security/run.mjs",
    "test:security:real": "node tests/security/run.mjs --target=real",
    "test:security:cloud": "node tests/security/run.mjs --target=cloud",
    "test:security:cloud-live": "node tests/security/run.mjs --target=cloud-live",
    "account": "node scripts/setup-account.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:tools": "vitest run --config vitest.tools.config.ts",
    "test:backup": "vitest run --config vitest.tools.config.ts tests/backup",
    "test:cloud": "vitest run --config vitest.tools.config.ts tests/cloud",
    "backup:local": "node scripts/backup/backup-local.mjs",
    "backup:cloud": "node scripts/backup/backup-cloud.mjs",
    "backup:verify": "node scripts/backup/verify-backup.mjs",
    "cloud:status": "node scripts/cloud/status.mjs",
    "cloud:migrate": "node scripts/cloud/migrate.mjs",
    "cloud:account": "node scripts/cloud/account.mjs",
    "setup:windows": "node tools/windows/setup.mjs",
    "supabase": "node tools/windows/supabase.mjs",
    "tauri": "node tools/windows/tauri.mjs",
    "desktop:build:cloud": "node tools/windows/desktop-build.mjs cloud",
    "desktop:build:local": "node tools/windows/desktop-build.mjs local"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
