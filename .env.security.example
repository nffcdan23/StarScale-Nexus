# Settings for running the security checks against a REAL LOCAL Supabase stack
# (npm run test:security:real). Not needed for the simulated checks.
#
# Copy this file to .env.security.local and fill in the values the local
# Supabase stack prints when it starts. That copy is never committed.
# The checks refuse to run against anything that is not this computer.

NEXUS_TEST_DB_URL=
NEXUS_TEST_API_URL=
NEXUS_TEST_PUBLISHABLE_KEY=
NEXUS_TEST_SECRET_KEY=
