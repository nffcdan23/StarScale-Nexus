# Settings the Nexus app reads in the browser. Only these two are allowed:
# both are public by design. Never put a secret key here; the app refuses one,
# and the build fails if one ends up in the app files.
#
# Copy this file to .env.local (never committed) on the Windows PC and fill it
# in from the values the local Supabase stack prints when it starts:
#   VITE_SUPABASE_URL             the API address, for example http://127.0.0.1:54321
#   VITE_SUPABASE_PUBLISHABLE_KEY the publishable key (starts sb_publishable_)

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
